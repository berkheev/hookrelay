APP_NAME=hookrelay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hookrelay
DB_USERNAME=hookrelay
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=hookrelay
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10

OCTANE_SERVER=swoole

HOOKRELAY_SOURCES_FILE=/app/sources.json
HOOKRELAY_ADMIN_USER=admin
# Leave empty to disable dashboard/API auth locally.
HOOKRELAY_ADMIN_PASSWORD=
HOOKRELAY_MAX_ATTEMPTS=8
HOOKRELAY_BASE_DELAY=10
HOOKRELAY_MAX_DELAY=3600
HOOKRELAY_RATE_LIMIT=600
HOOKRELAY_RETENTION_DAYS=14
